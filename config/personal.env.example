# Personal bot bootstrap (SPEC §2.2; CONVENTIONS §12). No secret ever sits in this file.
# The real file is ~/Library/Application Support/Yordamchi/personal.env (mode 0600). The token lives in the macOS login
# Keychain and this line only names the item. The personal process can never read the dev token's item (UC-36).
PERSONAL_BOT_TOKEN=@keychain:uz.yordamchi/personal-bot-token
OWNER_ID=<your-telegram-user-id>
# Optional: the private group of the personal bot; leave empty for direct messages only.
PERSONAL_GROUP_ID=
