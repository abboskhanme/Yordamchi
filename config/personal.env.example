# Personal bot bootstrap (SPEC §2.2; CONVENTIONS §12). Placeholders only.
# The real file is ~/Library/Application Support/Yordamchi/personal.env (mode 0600). It must not hold the dev token
# (UC-36): the personal process never sees it.
PERSONAL_BOT_TOKEN=<token-from-BotFather>
OWNER_ID=<your-telegram-user-id>
# Optional: the private group of the personal bot; leave empty for direct messages only.
PERSONAL_GROUP_ID=
