# Dev bot bootstrap (SPEC §2.2; CONVENTIONS §12). Placeholders only.
# The real file is ~/Library/Application Support/Yordamchi/dev.env (mode 0600), written by scripts/install.py from
# hidden terminal input. Never commit it and never paste a token into chat.
DEV_BOT_TOKEN=<token-from-BotFather>
OWNER_ID=<your-telegram-user-id>
DEV_GROUP_ID=<dev-group-id-negative>
