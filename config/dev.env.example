# Dev bot bootstrap (SPEC §2.2; CONVENTIONS §12). No secret ever sits in this file.
# The real file is ~/Library/Application Support/Yordamchi/dev.env (mode 0600), written by scripts/install.py. The token
# itself lives in the macOS login Keychain; this line only names the item (the installer stores it there from hidden
# terminal input). A plaintext token here is refused at startup. Never paste a token into chat.
DEV_BOT_TOKEN=@keychain:uz.yordamchi/dev-bot-token
OWNER_ID=<your-telegram-user-id>
DEV_GROUP_ID=<dev-group-id-negative>
