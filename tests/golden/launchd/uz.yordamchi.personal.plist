<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- uz.yordamchi.personal (SPEC §9.1). Rendered by scripts/install.py; copied to ~/Library/LaunchAgents and loaded
     only with the installer's enable-personal flag (P3). Until then it stays in DATA/launchd, which launchd never
     reads. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>uz.yordamchi.personal</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/owner/Library/Application Support/Yordamchi/releases/current/.venv/bin/python</string>
		<string>-I</string>
		<string>-m</string>
		<string>yordamchi.bots.personal.app</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>YORDAMCHI_DATA_DIR</key>
		<string>/Users/owner/Library/Application Support/Yordamchi</string>
		<key>YORDAMCHI_ENV_FILE</key>
		<string>/Users/owner/Library/Application Support/Yordamchi/personal.env</string>
		<key>PATH</key>
		<string>/Users/owner/Library/Application Support/Yordamchi/releases/current/shims:/Users/owner/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/owner/Library/Application Support/Yordamchi/run</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>20</integer>
	<key>AbandonProcessGroup</key>
	<false/>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>8192</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/owner/Library/Logs/Yordamchi/uz.yordamchi.personal.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/owner/Library/Logs/Yordamchi/uz.yordamchi.personal.launchd.log</string>
</dict>
</plist>
