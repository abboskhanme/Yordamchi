#!/bin/sh
# Yordamchi gate shim for rsync (SPEC §5.7 Layer 2): the dev bot decides; no answer means no rsync (exit 126).
[ -n "$YORDAMCHI_PY" ] || { echo "yordamchi: rsync refused by the gate (gate_unreachable)" >&2; exit 126; }
exec "$YORDAMCHI_PY" -I -m yordamchi.bots.cli.shim "${0%/*}" rsync "$@"
